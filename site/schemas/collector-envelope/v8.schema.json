{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardana.dev/schemas/collector-envelope/v8.schema.json",
  "title": "Guardana Collector Envelope v8",
  "description": "What `--reporter server://<url>` POSTs to `/findings`: one run's finding channels, what ran, and, when the run declared them, its deployment and its identity. Versioned independently of the CLI and of the saved run. A collector accepts every envelope version from 2 up to its own and refuses a newer one with 422, naming the versions it speaks. The project a submission lands in comes from the API key, never from the envelope.",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "findings",
    "unverified",
    "errors",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 8
    },
    "source": {
      "description": "What the run examined: a path, or an endpoint and model.",
      "$ref": "#/$defs/string"
    },
    "findings": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "unverified": {
      "description": "Checks that ran and could not reach a verdict. Never folded into findings and never dropped: a check that could not grade is not a pass.",
      "type": "array",
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "errors": {
      "description": "Checks that could not run at all.",
      "type": "array",
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/checkError"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "deployment": {
      "$ref": "#/$defs/deployment"
    },
    "run": {
      "$ref": "#/$defs/run"
    }
  },
  "$defs": {
    "string": {
      "type": "string",
      "maxLength": 4096
    },
    "text": {
      "type": "string",
      "maxLength": 65536
    },
    "nullableString": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/string"
        }
      ]
    },
    "nullableCount": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "nullableTimestamp": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      ]
    },
    "finding": {
      "type": "object",
      "required": [
        "rule_id",
        "severity",
        "title",
        "taxonomy",
        "target_ref",
        "evidence",
        "verdict",
        "identity"
      ],
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "INFO",
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "taxonomy": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/taxonomyRef"
          }
        },
        "target_ref": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "description": "Why the finding was raised, redacted by the agent before it is sent.",
          "type": "object",
          "required": [
            "summary",
            "detail"
          ],
          "additionalProperties": false,
          "properties": {
            "summary": {
              "$ref": "#/$defs/text"
            },
            "detail": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "verdict": {
          "description": "An evaluator's judgement; null on a static finding.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/verdict"
            }
          ]
        },
        "identity": {
          "description": "What links this sighting to the same finding in another run. Computed by the agent; a collector stores it and never recomputes it.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "taxonomyRef": {
      "description": "One framework reference. `framework` and `id` together are the identity — a short id means different controls in different editions — and `title` is display data, so a collector holding no catalogue can still show what the entry is called.",
      "type": "object",
      "required": [
        "framework",
        "id",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "framework": {
          "$ref": "#/$defs/string"
        },
        "id": {
          "$ref": "#/$defs/string"
        },
        "title": {
          "$ref": "#/$defs/string"
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": [
        "outcome",
        "confidence",
        "rationale",
        "evaluator_id"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "evaluator_id": {
          "$ref": "#/$defs/string"
        }
      }
    },
    "checkError": {
      "type": "object",
      "required": [
        "source",
        "stage",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/string"
        },
        "stage": {
          "$ref": "#/$defs/string"
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "summary": {
      "description": "What the run did, beyond the findings themselves. Which rules ran is named, not only counted: a count cannot tell an agent that found nothing from one whose profile excluded the rules that would have.",
      "type": "object",
      "required": [
        "rules_run",
        "rules_executed",
        "rules_skipped",
        "max_severity",
        "unverified",
        "errors"
      ],
      "additionalProperties": false,
      "properties": {
        "rules_run": {
          "type": "integer",
          "minimum": 0
        },
        "rules_executed": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/$defs/string"
          }
        },
        "rules_skipped": {
          "description": "Rules that did not run, each with the reason. `not_applicable` is the one reason that is not a coverage gap, and it is still not a pass.",
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/$defs/skippedRule"
          }
        },
        "max_severity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "enum": [
                "INFO",
                "LOW",
                "MEDIUM",
                "HIGH",
                "CRITICAL"
              ]
            }
          ]
        },
        "unverified": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "skippedRule": {
      "type": "object",
      "required": [
        "rule_id",
        "reason",
        "missing"
      ],
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/string"
        },
        "reason": {
          "type": "string",
          "enum": [
            "missing_capability",
            "unsafe_mode",
            "not_applicable",
            "not_recorded",
            "not_offered"
          ]
        },
        "missing": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "$ref": "#/$defs/string"
          }
        }
      }
    },
    "deployment": {
      "description": "What the run verified, where, and which version of it. Only the fields the run declared are present, and the block is absent when it declared none: an absent field means the run did not say, never not applicable.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "ai_system": {
          "$ref": "#/$defs/string"
        },
        "environment": {
          "$ref": "#/$defs/string"
        },
        "deployment_id": {
          "$ref": "#/$defs/string"
        },
        "commit_sha": {
          "$ref": "#/$defs/string"
        },
        "image_digest": {
          "$ref": "#/$defs/string"
        },
        "model_digest": {
          "$ref": "#/$defs/string"
        },
        "model_name": {
          "$ref": "#/$defs/string"
        },
        "model_revision": {
          "$ref": "#/$defs/string"
        }
      }
    },
    "run": {
      "description": "What the run itself was: its identity, its verdict, its cost. Not the run manifest, which is versioned on its own.",
      "type": "object",
      "required": [
        "run_id",
        "started_at",
        "completed_at",
        "tool_version",
        "gate",
        "evidence_mode",
        "requests",
        "input_tokens",
        "output_tokens",
        "wall_time_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "$ref": "#/$defs/string"
        },
        "started_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "completed_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "tool_version": {
          "$ref": "#/$defs/string"
        },
        "gate": {
          "description": "The run's verdict. `indeterminate` says the question was never answered; it is not a softer `fail`.",
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "indeterminate"
          ]
        },
        "evidence_mode": {
          "type": "string",
          "enum": [
            "metadata_only",
            "redacted",
            "full"
          ]
        },
        "requests": {
          "$ref": "#/$defs/nullableCount"
        },
        "input_tokens": {
          "$ref": "#/$defs/nullableCount"
        },
        "output_tokens": {
          "$ref": "#/$defs/nullableCount"
        },
        "wall_time_seconds": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        }
      }
    }
  }
}
