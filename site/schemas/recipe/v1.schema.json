{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardana.dev/schemas/recipe/v1.schema.json",
  "title": "Guardana Recipe v1",
  "description": "guardana-recipe.yaml: the profile a team's checks come from, what answers them, and where the artifact goes. Hand-written; Guardana never rewrites it. Relative paths are read beside the recipe.",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "profile",
    "subject"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "$ref": "#/$defs/text"
    },
    "profile": {
      "$ref": "#/$defs/text",
      "description": "The guardana.yaml the checks come from."
    },
    "subject": {
      "type": "object",
      "dependentRequired": {
        "connection": [
          "kind"
        ]
      },
      "additionalProperties": false,
      "description": "What answers, and how: exactly one of `connection` or `recording`.",
      "properties": {
        "kind": {
          "enum": [
            "application",
            "model_harness"
          ],
          "description": "Declared by the team; there is no default. Required with `connection`; with `recording` it may be left to the recording's `subject_kind`, and the run is refused when the two differ or neither declares one."
        },
        "connection": {
          "type": "object",
          "required": [
            "url",
            "model"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "$ref": "#/$defs/text"
            },
            "model": {
              "$ref": "#/$defs/text"
            },
            "provider": {
              "$ref": "#/$defs/text"
            },
            "api_key_env": {
              "$ref": "#/$defs/text"
            },
            "adapter": {
              "$ref": "#/$defs/text"
            },
            "system_prompt_file": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "recording": {
          "$ref": "#/$defs/text"
        }
      },
      "oneOf": [
        {
          "required": [
            "connection"
          ]
        },
        {
          "required": [
            "recording"
          ]
        }
      ]
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ai_system": {
          "$ref": "#/$defs/text"
        },
        "environment": {
          "$ref": "#/$defs/text"
        },
        "deployment_id": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {
          "$ref": "#/$defs/text",
          "description": "A subdirectory beside the recipe; never the recipe's own directory or a path outside it."
        },
        "exchanges": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    }
  }
}
